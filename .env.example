# Base URL of the Strapi CMS (see ./cms). The site falls back to static
# content in src/i18n/translations.jsx if this is unreachable.
#
# Local:            http://localhost:1337
# Deployed (Vercel): the Railway CMS URL, e.g. https://your-service.up.railway.app
# Vite inlines this at build time, so changing it on Vercel requires a redeploy.
VITE_STRAPI_URL=http://localhost:1337
