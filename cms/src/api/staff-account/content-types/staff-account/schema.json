{
  "kind": "collectionType",
  "collectionName": "staff_accounts",
  "info": {
    "singularName": "staff-account",
    "pluralName": "staff-accounts",
    "displayName": "Staff Account",
    "description": "Create a new admin login here — saving creates the real account immediately with the password you set, no email required"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "temporaryPassword": {
      "type": "string",
      "required": true,
      "minLength": 8
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "Super Admin",
        "Menu & Carousel Editor"
      ],
      "required": true
    }
  }
}
