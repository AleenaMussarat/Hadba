      "type": "string",
      "required": true,
      "displayName": "First Name / الاسم الأول"
    },
    "lastName": {
      "type": "string",
      "required": true,
      "displayName": "Last Name / الاسم الأخير"
    },
    "email": {
      "type": "email",
      "required": true,
      "displayName": "Email / البريد الإلكتروني"
    },
    "temporaryPassword": {
      "type": "string",
      "required": true,
      "minLength": 8,
      "displayName": "Temporary Password / كلمة المرور المؤقتة"
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "Super Admin",
        "Editor"
      ],
      "required": true,
      "displayName": "Role / الدور"
    }
  }
