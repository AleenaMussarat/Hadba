{
  "kind": "collectionType",
  "collectionName": "inquiries",
  "info": {
    "singularName": "inquiry",
    "pluralName": "inquiries",
    "displayName": "Inquiry / استفسار",
    "description": "A reservation inquiry submitted from the website's Inquiries form / استفسار حجز تم إرساله عبر نموذج الاستفسارات في الموقع"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "displayName": "Name / الاسم"
    },
    "phone": {
      "type": "string",
      "required": true,
      "displayName": "Phone / الهاتف"
    },
    "guests": {
      "type": "integer",
      "required": true,
      "displayName": "Guests / الضيوف"
    },
    "date": {
      "type": "date",
      "required": true,
      "displayName": "Date / التاريخ"
    },
    "time": {
      "type": "time",
      "required": true,
      "displayName": "Time / الوقت"
    },
    "notes": {
      "type": "text",
      "displayName": "Notes / الملاحظات"
    },
    "stage": {
      "type": "enumeration",
      "enum": [
        "New",
        "Contacted",
        "Confirmed",
        "Cancelled"
      ],
      "default": "New",
      "displayName": "Stage / الحالة"
    }
  }
}
