{
  "kind": "collectionType",
  "collectionName": "menu_items",
  "info": {
    "singularName": "menu-item",
    "pluralName": "menu-items",
    "displayName": "Menu Item / عنصر القائمة",
    "description": "A single dish on the menu, English and Arabic together on one entry / طبق واحد في القائمة، الإنجليزية والعربية معًا في إدخال واحد"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "nameEn": {
      "type": "string",
      "required": true,
      "displayName": "Name (EN) / الاسم (EN)"
    },
    "nameAr": {
      "type": "string",
      "required": true,
      "displayName": "Name (AR) / الاسم (AR)"
    },
    "descriptionEn": {
      "type": "text",
      "displayName": "Description (EN) / الوصف (EN)"
    },
    "descriptionAr": {
      "type": "text",
      "displayName": "Description (AR) / الوصف (AR)"
    },
    "price": {
      "type": "decimal",
      "required": true,
      "displayName": "Price / السعر"
    },
    "calories": {
      "type": "integer",
      "displayName": "Calories / السعرات"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "displayName": "Featured / مميز"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "displayName": "Order / الترتيب"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "displayName": "Image / الصورة"
    },
    "categoryEn": {
      "type": "enumeration",
      "enum": [
        "Breakfast",
        "Traditional Dishes",
        "Madhghoot & Kabsa Barriya",
        "Goat Haneeth",
        "Camel Haneeth",
        "Chicken",
        "Whole Lamb",
        "Rice",
        "Appetizers",
        "Sides",
        "Salads",
        "Drinks",
        "Desserts"
      ],
      "required": true,
      "displayName": "Category (EN) / الفئة (EN)"
    },
    "categoryAr": {
      "type": "enumeration",
      "enum": [
        "الفطور",
        "الأكلات الشعبية",
        "المضغوط",
        "الأطباق الرئيسية",
        "الحاشي",
        "الدجاج",
        "لحم الذبيحة",
        "الرز",
        "المقبلات",
        "الإيدامات",
        "السلطات",
        "المشروبات",
        "الحلا"
      ],
      "required": true,
      "displayName": "Category (AR) / الفئة (AR)"
    }
  }
}