{
  "kind": "collectionType",
  "collectionName": "menu_items",
  "info": {
    "singularName": "menu-item",
    "pluralName": "menu-items",
    "displayName": "Menu Item / عنصر القائمة",
    "description": "A single dish on the menu, English and Arabic together on one entry / طبق واحد في القائمة، الإنجليزية والعربية معًا في إدخال واحد"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nameEn": {
      "type": "string",
      "required": true
    },
    "nameAr": {
      "type": "string",
      "required": true
    },
    "descriptionEn": {
      "type": "text"
    },
    "descriptionAr": {
      "type": "text"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "calories": {
      "type": "integer"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "menuCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::menu-category.menu-category",
      "inversedBy": "menuItems"
    }
  }
}