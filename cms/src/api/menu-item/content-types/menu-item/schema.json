{
  "kind": "collectionType",
  "collectionName": "menu_categories",
  "info": {
    "singularName": "menu-category",
    "pluralName": "menu-categories",
    "displayName": "Menu Category / فئة القائمة",
    "description": "Reusable menu categories for all menu items / فئات قائمة قابلة لإعادة الاستخدام لجميع عناصر القائمة"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nameEn": {
      "type": "string",
      "required": true
    },
    "nameAr": {
      "type": "string",
      "required": true
    },
    "displayLabel": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "menuItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu-item.menu-item",
      "mappedBy": "menuCategory"
    }
  }
}